<UserControl x:Class="Cwseo.NINA.ManualFocuser.Dockables.ManualFocuserDockableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Cwseo.NINA.ManualFocuser.Dockables"
             xmlns:ninactrl="clr-namespace:NINA.CustomControlLibrary;assembly=NINA.CustomControlLibrary"
             xmlns:enum="clr-namespace:NINA.Core.Enum;assembly=NINA.Core"
             xmlns:ns="clr-namespace:NINA.Core.Locale;assembly=NINA.Core"
             xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Contrib.Wpf"
             xmlns:oxys="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf.Shared"
             xmlns:util="clr-namespace:NINA.Core.Utility;assembly=NINA.Core"
             xmlns:wpfutil="clr-namespace:NINA.WPF.Base.Utility;assembly=NINA.WPF.Base"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="650">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <wpfutil:SharedResourceDictionary Source="/NINA.WPF.Base;component/Resources/StaticResources/Brushes.xaml" />
                <wpfutil:SharedResourceDictionary Source="/NINA.WPF.Base;component/Resources/StaticResources/SVGDictionary.xaml" />
                <wpfutil:SharedResourceDictionary Source="/NINA.WPF.Base;component/Resources/StaticResources/Converters.xaml" />
                <wpfutil:SharedResourceDictionary Source="/NINA.WPF.Base;component/Resources/StaticResources/ProfileService.xaml" />
                <wpfutil:SharedResourceDictionary Source="/NINA.WPF.Base;component/Resources/Styles/CheckBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FocusCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="Padding" Value="6,3"/>
            </Style>
            <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/></Style>
            <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/></Style>
            <Style x:Key="FocusButton" TargetType="Button">
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource SecondaryBrush}"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource SecondaryBrush}"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="380"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <Border Style="{StaticResource FocusCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Focus star" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Bright stars visible from your NINA profile location" Margin="0,3,0,0" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshFocusTargetsCommand}" Style="{StaticResource FocusButton}" Margin="10,0,0,0"/>
                        </Grid>
                        <Grid Margin="0,12,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/><ColumnDefinition Width="65"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                            <TextBlock Text="STAR" Foreground="{StaticResource SecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="MAG" Foreground="{StaticResource SecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="ALT" Foreground="{StaticResource SecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="AZ" Foreground="{StaticResource SecondaryBrush}"/>
                        </Grid>
                        <ListBox ItemsSource="{Binding FocusTargets}" SelectedItem="{Binding SelectedFocusTarget}" Height="115" BorderThickness="0"
                                 Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource PrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="6,6"/>
                                    <Setter Property="Template"><Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="4" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource BorderBrush}"/></Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource SecondaryBrush}"/></Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource SecondaryBrush}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value></Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/><ColumnDefinition Width="65"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Magnitude, StringFormat=F1}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Altitude, StringFormat={}{0:F1}°}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Azimuth, StringFormat={}{0:F1}°}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Minimum altitude" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Width="45" MinHeight="32" VerticalContentAlignment="Center" Text="{Binding MinimumFocusAltitude, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="°" VerticalAlignment="Center" Margin="4,0,16,0"/>
                            <Button Content="GOTO selected star" Command="{Binding GotoFocusTargetCommand}" Style="{StaticResource FocusButton}" FontWeight="SemiBold"
                                    ToolTip="Connect and unpark the mount; disconnect the guider. Capture and focus operations must be idle."/>
                            <Button Content="Stop" Command="{Binding CancelGotoCommand}" Style="{StaticResource FocusButton}" Margin="6,0,0,0"
                                    Visibility="{Binding IsGoingToFocusTarget, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding FocusTargetStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FocusCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Manual focus" FontSize="16" FontWeight="SemiBold"/>
                            <CheckBox Grid.Column="1" Content="Expose after move" IsChecked="{Binding TakeShootAfterMove}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                        <WrapPanel Margin="0,12,0,0">
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="Target position" Foreground="{StaticResource SecondaryBrush}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="90" MinHeight="32" VerticalContentAlignment="Center" Text="{Binding TargetPosition, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Style="{StaticResource FocusButton}" Content="Move" MinWidth="65" MinHeight="32" Margin="6,0,0,0" Command="{Binding MoveToPositionCommand}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Step size" Foreground="{StaticResource SecondaryBrush}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="65" MinHeight="32" VerticalContentAlignment="Center" Text="{Binding UserStep, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Style="{StaticResource FocusButton}" Content="In −" MinWidth="65" MinHeight="32" Margin="6,0,0,0" Command="{Binding MoveINCommand}"/>
                                    <Button Style="{StaticResource FocusButton}" Content="Out +" MinWidth="65" MinHeight="32" Margin="6,0,0,0" Command="{Binding MoveOUTCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="Use best position" Command="{Binding InputResetCommand}" Style="{StaticResource FocusButton}" ToolTip="Set target to the best measured position and restore the configured step size."/>
                            <Button Content="Clear chart" Command="{Binding ClearChartCommand}" Style="{StaticResource FocusButton}" Margin="6,0,0,0"/>
                            <Button Content="Stop focus" Command="{Binding HaltFocuserCommand}" Style="{StaticResource FocusButton}" Margin="6,0,0,0"
                                    Visibility="{Binding IsMoving, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FocusCard}">
                    <Expander Header="Autofocus" IsExpanded="False">
                        <StackPanel Margin="0,10,0,0">
                            <WrapPanel>
                                <TextBlock Text="Method" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox MinWidth="170" MinHeight="32" SelectedIndex="0" Margin="0,0,8,0"><ComboBoxItem Content="Linear scan"/></ComboBox>
                                <Button Style="{StaticResource FocusButton}" Content="Run autofocus" MinWidth="110" MinHeight="32" Command="{Binding LinearAFCommand}"/>
                            </WrapPanel>
                            <CheckBox Content="Single pass" IsChecked="{Binding UseOnePass}" Margin="0,10,0,0" IsEnabled="{Binding IsMoving, Converter={StaticResource InverseBooleanConverter}}"/>
                            <TextBlock Text="Scan at fixed intervals. Each pass shows a quadratic fit; the current routine uses measured values to choose its stopping position."
                                       TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource SecondaryBrush}"/>
                        </StackPanel>
                    </Expander>
                </Border>
                <Border Style="{StaticResource FocusCard}" Visibility="{Binding IsSpikeMetricEnabled, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                    <Expander Header="Spike analysis" IsExpanded="False">
                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock Text="Angle" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Width="55" MinHeight="32" VerticalContentAlignment="Center" Text="{Binding SpikeAngle, UpdateSourceTrigger=LostFocus}"/>
                            <CheckBox Content="Auto" IsChecked="{Binding AutoSpikeAngle}" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBlock Text="{Binding MeasuredAngleText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="Use angle" Command="{Binding UseMeasuredAngleCommand}" Style="{StaticResource FocusButton}"/>
                        </WrapPanel>
                    </Expander>
                </Border>
                <WrapPanel Margin="2,0,0,8">
                    <TextBlock Text="Best HFR  " Foreground="{StaticResource SecondaryBrush}"/>
                    <TextBlock Text="{Binding MinHFR, StringFormat=F3}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                    <TextBlock Text="Position  " Foreground="{StaticResource SecondaryBrush}"/>
                    <TextBlock Text="{Binding MinStep}" Margin="0,0,12,0"/>
                    <TextBlock Text="Δ HFR  " Foreground="{StaticResource SecondaryBrush}"/>
                    <TextBlock Text="{Binding HFRDelta, StringFormat=F3}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding SpikeDisplayStatus}" Foreground="{StaticResource SecondaryBrush}"/>
                </WrapPanel>
            </StackPanel>
            <oxy:Plot
                Grid.Row="1" Margin="0,0,0,0"
                Background="{StaticResource BackgroundBrush}"
                PlotAreaBackground="{StaticResource BackgroundBrush}"
                PlotAreaBorderColor="{Binding Path=Color, Source={StaticResource BorderBrush}}">
                <oxy:Plot.Legends>
                    <oxy:Legend
                        IsLegendVisible="True"
                        LegendBackground="{Binding Path=Color, Source={StaticResource BackgroundBrush}}"
                        LegendBorder="{Binding Path=Color, Source={StaticResource BorderBrush}}"
                        LegendFontSize="12"
                        LegendMaxHeight="35"
                        LegendOrientation="Horizontal"
                        LegendPadding="2"
                        LegendPlacement="Outside"
                        LegendPosition="TopCenter"
                        LegendSymbolLength="10"
                        LegendTextColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}" />
                </oxy:Plot.Legends>
                <oxy:Plot.Axes>
                    <oxy:LinearAxis
                    Title="Average HFR"
                    TitleColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                    AxislineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                    EndPosition="1"
                    IsPanEnabled="False"
                    IsZoomEnabled="True"
                    MajorGridlineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}, Converter={StaticResource SetAlphaToColorConverter}, ConverterParameter=60}"
                    MajorGridlineStyle="LongDash"
                    MaximumPadding="0.1"
                    MinimumPadding="0.1"
                    Position="Left"
                    StartPosition="0"
                    TextColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                    TicklineColor="{Binding Path=Color, Source={StaticResource SecondaryBrush}}" />

                    <oxy:LinearAxis
                    Title="Spike Metric"
                    IsAxisVisible="{Binding HasSpikePoints}"
                    TitleColor="{Binding Path=Color, Source={StaticResource NotificationWarningBrush}}"
                    AxislineColor="{Binding Path=Color, Source={StaticResource NotificationWarningBrush}}"
                    EndPosition="1"
                    IsPanEnabled="False"
                    IsZoomEnabled="False"
                    MajorGridlineColor="{Binding Path=Color, Source={StaticResource NotificationWarningBrush}, Converter={StaticResource SetAlphaToColorConverter}, ConverterParameter=60}"
                    MajorGridlineStyle="None"
                    MaximumPadding="0.1"
                    MinimumPadding="0.1"
                    Key="SecondaryY"
                    Position="Right"
                    StartPosition="0"
                    TextColor="{Binding Path=Color, Source={StaticResource NotificationWarningBrush}}"
                    TicklineColor="{Binding Path=Color, Source={StaticResource SecondaryBrush}}" />

                    <oxy:LinearAxis
                    Title="Focuser Position"
                    TitleColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                    AxislineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                    EndPosition="1"
                    IsPanEnabled="False"
                    IsZoomEnabled="False"
                    MajorGridlineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}, Converter={StaticResource SetAlphaToColorConverter}, ConverterParameter=60}"
                    MajorGridlineStyle="LongDash"
                    MaximumPadding="0.1"
                    MinimumPadding="0.1"
                    Position="Bottom"
                    StartPosition="0"
                    TextColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                    TicklineColor="{Binding Path=Color, Source={StaticResource SecondaryBrush}}" />
                </oxy:Plot.Axes>
                <oxy:Plot.Series>
                    <oxy:ScatterErrorSeries
                        Title="HFR"
                        ItemsSource="{Binding HFRFocusPoints}"
                        MarkerFill="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                        ErrorBarColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                        MarkerSize="4"
                        MarkerType="Circle"/>
                    <oxy:ScatterErrorSeries
                        Title="Spike"
                        Visibility="{Binding HasSpikePoints, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}"
                        YAxisKey="SecondaryY"
                        ItemsSource="{Binding SpikeFocusPoints}"
                        MarkerFill="{Binding Path=Color, Source={StaticResource NotificationWarningBrush}}"
                        ErrorBarColor="{Binding Path=Color, Source={StaticResource NotificationWarningBrush}}"
                        MarkerSize="5"
                        MarkerType="Diamond"/>
                    <!-- Primary pass (coarse) -->
                    <oxy:ScatterSeries Title="Measured · coarse"
                                       ItemsSource="{Binding PlotFocusPointsPrimary}"
                                       DataFieldX="X"
                                       DataFieldY="Y"
                                       MarkerType="Circle"
                                       MarkerFill="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                                       MarkerStroke="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                                       MarkerSize="5"
                                       MarkerStrokeThickness="1"
                                       TrackerFormatString="Pos: {2:0}\nHFR: {4:0.000}" />

                    <oxy:LineSeries Title="Quadratic · coarse"
                                    ItemsSource="{Binding FitCurvePointsPrimary}"
                                    DataFieldX="X"
                                    DataFieldY="Y"
                                    Color="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                                    StrokeThickness="1.5"
                                    LineStyle="Solid"
                                    CanTrackerInterpolatePoints="True"
                                    TrackerFormatString="Fit (P0)\nPos: {2:0}\nHFR: {4:0.000}" />

                    <!-- Secondary pass (fine) -->
                    <oxy:ScatterSeries Title="Measured · fine"
                                       ItemsSource="{Binding PlotFocusPointsSecondary}"
                                       DataFieldX="X"
                                       DataFieldY="Y"
                                       MarkerType="Square"
                                       MarkerFill="{Binding Path=Color, Source={StaticResource SecondaryBrush}}"
                                       MarkerStroke="{Binding Path=Color, Source={StaticResource SecondaryBrush}}"
                                       MarkerSize="5"
                                       MarkerStrokeThickness="1"
                                       TrackerFormatString="Pos: {2:0}\nHFR: {4:0.000}" />

                    <oxy:LineSeries Title="Quadratic · fine"
                                    ItemsSource="{Binding FitCurvePointsSecondary}"
                                    DataFieldX="X"
                                    DataFieldY="Y"
                                    Color="{Binding Path=Color, Source={StaticResource SecondaryBrush}}"
                                    StrokeThickness="1.5"
                                    LineStyle="Dash"
                                    CanTrackerInterpolatePoints="True"
                                    TrackerFormatString="Fit (P1)\nPos: {2:0}\nHFR: {4:0.000}" />
                </oxy:Plot.Series>
                <oxy:Plot.Annotations>
                    <oxy:PointAnnotation
                        Fill="{Binding Path=Color, Source={StaticResource NotificationErrorBrush}}"
                        Shape="Triangle"
                        Size="8"
                        Text="{Binding MinHFR, StringFormat=F3}"
                        TextColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                        X="{Binding MinStep}"
                        Y="{Binding MinHFR}" />
                </oxy:Plot.Annotations>
            </oxy:Plot>
        </Grid>
    </ScrollViewer>
</UserControl>
