<UserControl x:Class="Cwseo.NINA.ManualFocuser.Dockables.ManualFocuserDockableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Cwseo.NINA.ManualFocuser.Dockables"
             xmlns:ninactrl="clr-namespace:NINA.CustomControlLibrary;assembly=NINA.CustomControlLibrary"
             xmlns:enum="clr-namespace:NINA.Core.Enum;assembly=NINA.Core"
             xmlns:ns="clr-namespace:NINA.Core.Locale;assembly=NINA.Core"
             xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Contrib.Wpf"
             xmlns:oxys="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf.Shared"
             xmlns:util="clr-namespace:NINA.Core.Utility;assembly=NINA.Core"
             xmlns:wpfutil="clr-namespace:NINA.WPF.Base.Utility;assembly=NINA.WPF.Base"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="650">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <wpfutil:SharedResourceDictionary Source="/NINA.WPF.Base;component/Resources/StaticResources/Brushes.xaml" />
                <wpfutil:SharedResourceDictionary Source="/NINA.WPF.Base;component/Resources/StaticResources/SVGDictionary.xaml" />
                <wpfutil:SharedResourceDictionary Source="/NINA.WPF.Base;component/Resources/StaticResources/Converters.xaml" />
                <wpfutil:SharedResourceDictionary Source="/NINA.WPF.Base;component/Resources/StaticResources/ProfileService.xaml" />
                <wpfutil:SharedResourceDictionary Source="/NINA.WPF.Base;component/Resources/Styles/CheckBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FocusCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="MinHeight" Value="28"/>
<Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="Padding" Value="6,3"/>
            </Style>
            <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/></Style>
            <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/></Style>
            <Style x:Key="FocusButton" TargetType="Button">
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="Padding" Value="9,3"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{StaticResource ButtonBackgroundSelectedBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource ButtonForegroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource SecondaryBrush}"/></Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{StaticResource ButtonBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource ButtonForegroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
        <Grid x:Name="LayoutRoot" Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="ControlsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <local:FocusCardsPanel>
                <Border Style="{StaticResource FocusCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="FocusModeSelector" SelectedValuePath="Tag" SelectedValue="{Binding FocusMode}" MinHeight="28" MinWidth="105"
                                      IsEnabled="{Binding IsMoving, Converter={StaticResource InverseBooleanConverter}}">
                                <ComboBoxItem Content="Manual focus" Tag="Manual"/>
                                <ComboBoxItem Content="Auto focus" Tag="Auto"/>
<ComboBoxItem Content="Live focus" Tag="Live"/>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Use best" Command="{Binding InputResetCommand}" Margin="5,0,0,0"
                                    IsEnabled="{Binding IsMoving, Converter={StaticResource InverseBooleanConverter}}"
                                    ToolTip="Set target to the best measured position and restore the configured step size.">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FocusButton}">
                                    <Style.Triggers><DataTrigger Binding="{Binding SelectedValue, ElementName=FocusModeSelector}" Value="Auto"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding SelectedValue, ElementName=FocusModeSelector}" Value="Live"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style></Button.Style>
                            </Button>
                            <CheckBox Grid.Column="2" Content="Expose" IsChecked="{Binding TakeShootAfterMove}" VerticalAlignment="Center" FontSize="11" Margin="6,0,0,0" ToolTip="Take an exposure after each focus movement."><CheckBox.Style><Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding FocusMode}" Value="Live"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox>
                        </Grid>
                        <WrapPanel Margin="0,6,0,0">
                            <WrapPanel.Style><Style TargetType="WrapPanel">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedValue, ElementName=FocusModeSelector}" Value="Auto"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding SelectedValue, ElementName=FocusModeSelector}" Value="Live"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style></WrapPanel.Style>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,3">
                                <TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{StaticResource SecondaryBrush}"/>
                                <TextBox Width="70" MinHeight="28" VerticalContentAlignment="Center" Text="{Binding TargetPosition, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Style="{StaticResource FocusButton}" Content="Move" Margin="4,0,0,0" Command="{Binding MoveToPositionCommand}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="Step" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{StaticResource SecondaryBrush}"/>
                                <TextBox Width="52" MinHeight="28" VerticalContentAlignment="Center" Text="{Binding UserStep, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Style="{StaticResource FocusButton}" Content="In −" Margin="4,0,0,0" Command="{Binding MoveINCommand}"/>
                                <Button Style="{StaticResource FocusButton}" Content="Out +" Margin="4,0,0,0" Command="{Binding MoveOUTCommand}"/>
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <WrapPanel.Style><Style TargetType="WrapPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedValue, ElementName=FocusModeSelector}" Value="Auto"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></WrapPanel.Style>
                            <ComboBox x:Name="AfAlgorithmSelector" MinWidth="110" MinHeight="28" SelectedValuePath="Tag" SelectedValue="Linear" Margin="0,0,5,3"
                                      IsEnabled="{Binding IsMoving, Converter={StaticResource InverseBooleanConverter}}">
                                <ComboBoxItem Content="Linear scan" Tag="Linear"/>
                                <ComboBoxItem Content="Bahtinov scan (experimental)" Tag="Bahtinov"/>
                            </ComboBox>
                            <Button Content="Run autofocus" Command="{Binding LinearAFCommand}" Margin="0,0,0,3">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FocusButton}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedValue, ElementName=AfAlgorithmSelector}" Value="Bahtinov"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button Content="Run Bahtinov AF" Command="{Binding BahtinovAFCommand}" Margin="0,0,0,3">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FocusButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedValue, ElementName=AfAlgorithmSelector}" Value="Bahtinov"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers></Style></Button.Style>
                            </Button>
                            <CheckBox Content="Single pass" IsChecked="{Binding UseOnePass}" Margin="8,0,0,3" VerticalAlignment="Center"
                                      IsEnabled="{Binding IsMoving, Converter={StaticResource InverseBooleanConverter}}">
                                <CheckBox.Style><Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/><Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedValue, ElementName=AfAlgorithmSelector}" Value="Bahtinov"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style></CheckBox.Style>
                            </CheckBox>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource FocusCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Focus star" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Alt ≥" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{StaticResource SecondaryBrush}"/>
                                <TextBox Width="38" MinHeight="26" VerticalContentAlignment="Center" Text="{Binding MinimumFocusAltitude, UpdateSourceTrigger=LostFocus}" ToolTip="Minimum star altitude; refresh after changing this value."/>
                                <TextBlock Text="°" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox MinHeight="28" ItemsSource="{Binding FocusTargets}" SelectedItem="{Binding SelectedFocusTarget}" MaxDropDownHeight="240"
                                      ToolTip="Select a focus star. The list loads automatically when this panel opens.">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshFocusTargetsCommand}" Style="{StaticResource FocusButton}" Margin="5,0,0,0" ToolTip="Refresh visible focus stars using the current time and profile location."/>
                            <Button Grid.Column="2" Content="GOTO" Command="{Binding GotoFocusTargetCommand}" Style="{StaticResource FocusButton}" Margin="5,0,0,0"
                                    ToolTip="Go to the selected star. Connect and unpark the mount; disconnect the guider. Capture and focus operations must be idle."/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FocusTargetStatus}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FocusTargetStatus}" Foreground="{StaticResource SecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Stop GOTO" Command="{Binding CancelGotoCommand}" Style="{StaticResource FocusButton}" Margin="5,0,0,0"
                                    Visibility="{Binding IsGoingToFocusTarget, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}"/>
                        </Grid>
                        <Expander Header="Spike analysis" IsExpanded="False" Margin="0,4,0,0"
                                  Visibility="{Binding IsSpikeMetricEnabled, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="Angle" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Width="50" MinHeight="28" VerticalContentAlignment="Center" Text="{Binding SpikeAngle, UpdateSourceTrigger=LostFocus}"/>
                                <CheckBox Content="Auto" IsChecked="{Binding AutoSpikeAngle}" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock Text="{Binding MeasuredAngleText}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Button Content="Use angle" Command="{Binding UseMeasuredAngleCommand}" Style="{StaticResource FocusButton}"/>
                            </WrapPanel>
                        </Expander>
                    </StackPanel>
                </Border>
                </local:FocusCardsPanel>
                <Expander x:Name="FocusAssistExpander" Header="Bahtinov options" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,6">
                    <Expander.Style><Style TargetType="Expander"><Setter Property="IsExpanded" Value="False"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedValue, ElementName=FocusModeSelector}" Value="Auto"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers></Style></Expander.Style>
                    <Border Style="{StaticResource FocusCard}" Margin="0,4,0,0">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,5">
                                <TextBlock Text="Exposure ms" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Width="50" Text="{Binding PreviewExposureMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,8,0"/>
                                <TextBlock Text="ROI X/Y %" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Width="40" Text="{Binding PreviewCenterX, UpdateSourceTrigger=LostFocus}" Margin="0,0,3,0"/>
                                <TextBox Width="40" Text="{Binding PreviewCenterY, UpdateSourceTrigger=LostFocus}"/>
                            </WrapPanel>

                            <CheckBox Content="Bahtinov mask installed; isolated star centered" IsChecked="{Binding BahtinovMaskConfirmed}" Margin="0,2,0,4"
                                      ToolTip="Required for experimental autofocus. Scan uses NINA autofocus step size and initial offset count; current filter stays selected."/>
                            <TextBlock Text="{Binding RoiLocationText}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/>
<TextBlock Text="{Binding FocusAssistStatus}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/>
                            <Image Source="{Binding FocusPreviewImage}" MaxHeight="180" Stretch="Uniform"/>

                        </StackPanel>
                    </Border>
                </Expander>
                <Border>
                    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource FocusCard}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FocusMode}" Value="Live"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="Exposure ms" VerticalAlignment="Center" Margin="0,0,5,3"/>
                            <TextBox Width="50" Text="{Binding PreviewExposureMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,8,3"/>
                            <TextBlock Text="ROI X/Y %" VerticalAlignment="Center" Margin="0,0,5,3"/>
                            <TextBox Width="40" Text="{Binding PreviewCenterX, UpdateSourceTrigger=LostFocus}" Margin="0,0,3,3"/>
                            <TextBox Width="40" Text="{Binding PreviewCenterY, UpdateSourceTrigger=LostFocus}" Margin="0,0,8,3"/>
                            <Button Content="Select ROI" Command="{Binding SelectRoiCommand}" Style="{StaticResource FocusButton}" Margin="0,0,4,3" ToolTip="Stop live first. Capture the full frame, then click a star to select its ROI."/>
<Button Content="Start live" Command="{Binding StartFocusPreviewCommand}" Style="{StaticResource FocusButton}" Margin="0,0,4,3"/>
                            <Button Content="Stop live" Command="{Binding StopFocusPreviewCommand}" Style="{StaticResource FocusButton}" Margin="0,0,4,3"/>
                            <TextBlock Text="Step" VerticalAlignment="Center" Margin="4,0,5,3"/>
                            <TextBox Width="48" Text="{Binding UserStep, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,3"/>
                            <Button Content="In" Command="{Binding PreviewMoveInCommand}" Style="{StaticResource FocusButton}" Margin="0,0,4,3"/>
                            <Button Content="Out" Command="{Binding PreviewMoveOutCommand}" Style="{StaticResource FocusButton}" Margin="0,0,4,3"/>
                            <CheckBox Content="Bahtinov overlay" IsChecked="{Binding AnalyzeBahtinov}" VerticalAlignment="Center" Margin="4,0,0,3"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding RoiLocationText}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/>
<TextBlock Text="{Binding FocusAssistStatus}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/>
<TextBlock Text="{Binding LiveTimingText}" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource SecondaryBrush}" ToolTip="Capture+download is measured end to end. Host download is the separate duration reported by NINA; it can overlap driver work and is not pure USB transfer time. Preview/graph measures CPU preparation, not physical display latency."/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
            <Grid x:Name="ChartArea" Grid.Row="1" MinHeight="140"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding FocusMode}" Value="Live"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <WrapPanel Margin="2,0,6,0" VerticalAlignment="Center" ToolTip="{Binding SpikeDisplayStatus}">
                    <TextBlock Text="HFR  " Foreground="{StaticResource SecondaryBrush}"/>
                    <TextBlock Text="{Binding MinHFR, StringFormat=F3}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <TextBlock Text="Pos  " Foreground="{StaticResource SecondaryBrush}"/>
                    <TextBlock Text="{Binding MinStep}" Margin="0,0,10,0"/>
                    <TextBlock Text="Δ  " Foreground="{StaticResource SecondaryBrush}"/>
                    <TextBlock Text="{Binding HFRDelta, StringFormat=F3}"/>
                </WrapPanel>
                    <Button Grid.Column="1" Content="Stop focus" Command="{Binding HaltFocuserCommand}" Style="{StaticResource FocusButton}" Margin="0,0,5,0"
                            Visibility="{Binding IsMoving, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}"/>
                    <Button Grid.Column="2" Content="Clear chart" Command="{Binding ClearChartCommand}" Style="{StaticResource FocusButton}"/>
                </Grid>
            <oxy:Plot
                Grid.Row="1" Margin="0,0,0,0"
                Background="{StaticResource BackgroundBrush}"
                PlotAreaBackground="{StaticResource BackgroundBrush}"
                PlotAreaBorderColor="{Binding Path=Color, Source={StaticResource BorderBrush}}">
                <oxy:Plot.Legends>
                    <oxy:Legend
                        IsLegendVisible="True"
                        LegendBackground="{Binding Path=Color, Source={StaticResource BackgroundBrush}}"
                        LegendBorder="{Binding Path=Color, Source={StaticResource BorderBrush}}"
                        LegendFontSize="12"
                        LegendMaxHeight="35"
                        LegendOrientation="Horizontal"
                        LegendPadding="2"
                        LegendPlacement="Outside"
                        LegendPosition="TopCenter"
                        LegendSymbolLength="10"
                        LegendTextColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}" />
                </oxy:Plot.Legends>
                <oxy:Plot.Axes>
                    <oxy:LinearAxis
                    Title="Average HFR"
                    TitleColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                    AxislineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                    EndPosition="1"
                    IsPanEnabled="False"
                    IsZoomEnabled="True"
                    MajorGridlineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}, Converter={StaticResource SetAlphaToColorConverter}, ConverterParameter=60}"
                    MajorGridlineStyle="LongDash"
                    MaximumPadding="0.1"
                    MinimumPadding="0.1"
                    Position="Left"
                    StartPosition="0"
                    TextColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                    TicklineColor="{Binding Path=Color, Source={StaticResource SecondaryBrush}}" />

                    <oxy:LinearAxis
                    Title="Spike Metric"
                    IsAxisVisible="{Binding HasSpikePoints}"
                    TitleColor="{Binding Path=Color, Source={StaticResource NotificationWarningBrush}}"
                    AxislineColor="{Binding Path=Color, Source={StaticResource NotificationWarningBrush}}"
                    EndPosition="1"
                    IsPanEnabled="False"
                    IsZoomEnabled="False"
                    MajorGridlineColor="{Binding Path=Color, Source={StaticResource NotificationWarningBrush}, Converter={StaticResource SetAlphaToColorConverter}, ConverterParameter=60}"
                    MajorGridlineStyle="None"
                    MaximumPadding="0.1"
                    MinimumPadding="0.1"
                    Key="SecondaryY"
                    Position="Right"
                    StartPosition="0"
                    TextColor="{Binding Path=Color, Source={StaticResource NotificationWarningBrush}}"
                    TicklineColor="{Binding Path=Color, Source={StaticResource SecondaryBrush}}" />

                    <oxy:LinearAxis
                    Title="Focuser Position"
                    TitleColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                    AxislineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                    EndPosition="1"
                    IsPanEnabled="False"
                    IsZoomEnabled="False"
                    MajorGridlineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}, Converter={StaticResource SetAlphaToColorConverter}, ConverterParameter=60}"
                    MajorGridlineStyle="LongDash"
                    MaximumPadding="0.1"
                    MinimumPadding="0.1"
                    Position="Bottom"
                    StartPosition="0"
                    TextColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                    TicklineColor="{Binding Path=Color, Source={StaticResource SecondaryBrush}}" />
                </oxy:Plot.Axes>
                <oxy:Plot.Series>
                    <oxy:ScatterErrorSeries
                        Title="HFR"
                        ItemsSource="{Binding HFRFocusPoints}"
                        MarkerFill="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                        ErrorBarColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                        MarkerSize="4"
                        MarkerType="Circle"/>
                    <oxy:ScatterErrorSeries
                        Title="Spike"
                        Visibility="{Binding HasSpikePoints, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}"
                        YAxisKey="SecondaryY"
                        ItemsSource="{Binding SpikeFocusPoints}"
                        MarkerFill="{Binding Path=Color, Source={StaticResource NotificationWarningBrush}}"
                        ErrorBarColor="{Binding Path=Color, Source={StaticResource NotificationWarningBrush}}"
                        MarkerSize="5"
                        MarkerType="Diamond"/>
                    <!-- Primary pass (coarse) -->
                    <oxy:ScatterSeries Title="Measured · coarse"
                                       ItemsSource="{Binding PlotFocusPointsPrimary}"
                                       DataFieldX="X"
                                       DataFieldY="Y"
                                       MarkerType="Circle"
                                       MarkerFill="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                                       MarkerStroke="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                                       MarkerSize="5"
                                       MarkerStrokeThickness="1"
                                       TrackerFormatString="Pos: {2:0}\nHFR: {4:0.000}" />

                    <oxy:LineSeries Title="Quadratic · coarse"
                                    ItemsSource="{Binding FitCurvePointsPrimary}"
                                    DataFieldX="X"
                                    DataFieldY="Y"
                                    Color="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                                    StrokeThickness="1.5"
                                    LineStyle="Solid"
                                    CanTrackerInterpolatePoints="True"
                                    TrackerFormatString="Fit (P0)\nPos: {2:0}\nHFR: {4:0.000}" />

                    <!-- Secondary pass (fine) -->
                    <oxy:ScatterSeries Title="Measured · fine"
                                       ItemsSource="{Binding PlotFocusPointsSecondary}"
                                       DataFieldX="X"
                                       DataFieldY="Y"
                                       MarkerType="Square"
                                       MarkerFill="{Binding Path=Color, Source={StaticResource SecondaryBrush}}"
                                       MarkerStroke="{Binding Path=Color, Source={StaticResource SecondaryBrush}}"
                                       MarkerSize="5"
                                       MarkerStrokeThickness="1"
                                       TrackerFormatString="Pos: {2:0}\nHFR: {4:0.000}" />

                    <oxy:LineSeries Title="Quadratic · fine"
                                    ItemsSource="{Binding FitCurvePointsSecondary}"
                                    DataFieldX="X"
                                    DataFieldY="Y"
                                    Color="{Binding Path=Color, Source={StaticResource SecondaryBrush}}"
                                    StrokeThickness="1.5"
                                    LineStyle="Dash"
                                    CanTrackerInterpolatePoints="True"
                                    TrackerFormatString="Fit (P1)\nPos: {2:0}\nHFR: {4:0.000}" />
                </oxy:Plot.Series>
                <oxy:Plot.Annotations>
                    <oxy:PointAnnotation
                        Fill="{Binding Path=Color, Source={StaticResource NotificationErrorBrush}}"
                        Shape="Triangle"
                        Size="8"
                        Text="{Binding MinHFR, StringFormat=F3}"
                        TextColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                        X="{Binding MinStep}"
                        Y="{Binding MinHFR}" />
                </oxy:Plot.Annotations>
            </oxy:Plot>
            </Grid>
            <Grid Grid.Row="1" MinHeight="140">
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FocusMode}" Value="Live"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,5">
                    <Button DockPanel.Dock="Right" Content="Clear live graph" Command="{Binding ClearLiveGraphCommand}" Style="{StaticResource FocusButton}"/>
                    <TextBlock Text="{Binding LiveHfrText}" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,0,6,0"><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Image Source="{Binding LiveDisplayImage}" Stretch="Uniform" MouseLeftButtonDown="OnPreviewClick" Cursor="Cross" ToolTip="{Binding RoiLocationText}"/>
                    <oxy:Plot Grid.Row="1" Background="{StaticResource BackgroundBrush}" PlotAreaBackground="{StaticResource BackgroundBrush}">
                        <oxy:Plot.Axes><oxy:LinearAxis Position="Bottom" Title="Star profile (px)" TextColor="{Binding Color, Source={StaticResource PrimaryBrush}}" TitleColor="{Binding Color, Source={StaticResource PrimaryBrush}}"/><oxy:LinearAxis Position="Left" Minimum="0" Maximum="1.1" TextColor="{Binding Color, Source={StaticResource PrimaryBrush}}"/></oxy:Plot.Axes>
                        <oxy:Plot.Series><oxy:LineSeries ItemsSource="{Binding LiveStarProfile}" DataFieldX="X" DataFieldY="Y" Color="{Binding Color, Source={StaticResource SecondaryBrush}}"/></oxy:Plot.Series>
                    </oxy:Plot>
                </Grid>
                <oxy:Plot Grid.Row="1" Grid.Column="1" Background="{StaticResource BackgroundBrush}" PlotAreaBackground="{StaticResource BackgroundBrush}">
                    <oxy:Plot.Axes><oxy:LinearAxis Position="Bottom" Title="Elapsed seconds" TextColor="{Binding Color, Source={StaticResource PrimaryBrush}}" TitleColor="{Binding Color, Source={StaticResource PrimaryBrush}}"/><oxy:LinearAxis Position="Left" Title="Local HFR (px)" Minimum="0" TextColor="{Binding Color, Source={StaticResource PrimaryBrush}}" TitleColor="{Binding Color, Source={StaticResource PrimaryBrush}}"/></oxy:Plot.Axes>
                    <oxy:Plot.Series><oxy:LineSeries ItemsSource="{Binding LiveHfrPoints}" DataFieldX="X" DataFieldY="Y" Color="{Binding Color, Source={StaticResource SecondaryBrush}}" StrokeThickness="2"/></oxy:Plot.Series>
                </oxy:Plot>
            </Grid>
        </Grid>
</UserControl>
