<ResourceDictionary
    x:Class="Cwseo.NINA.ManualFocuser.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wpfutil="clr-namespace:NINA.WPF.Base.Utility;assembly=NINA.WPF.Base">
    <DataTemplate x:Key="Manual Focuser_Options">
        <Grid Margin="8" MaxWidth="480" HorizontalAlignment="Left">
            <!-- NINA composes this exported dictionary on a worker thread.
                 Load UI-owned shared resources only when the template is shown. -->
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <wpfutil:SharedResourceDictionary Source="/NINA.WPF.Base;component/Resources/StaticResources/Brushes.xaml" />
                        <wpfutil:SharedResourceDictionary Source="/NINA.WPF.Base;component/Resources/Styles/CheckBox.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Continuous camera streaming" Foreground="{DynamicResource PrimaryBrush}" />
                <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryBrush}"
                           Text="Use camera video when supported. Off uses consecutive exposures." />
            </StackPanel>
            <CheckBox Grid.Column="2" VerticalAlignment="Center"
                      Style="{StaticResource StandardCheckBox}"
                      AutomationProperties.Name="Continuous camera streaming"
                      IsChecked="{Binding UseFocusStreaming, Mode=TwoWay}" />

            <StackPanel Grid.Row="2">
                <TextBlock Text="Diagnostic recording" Foreground="{DynamicResource PrimaryBrush}" />
                <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryBrush}"
                           Text="Record timing and raw frames for troubleshooting." />
            </StackPanel>
            <CheckBox Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"
                      Style="{StaticResource StandardCheckBox}"
                      AutomationProperties.Name="Diagnostic recording"
                      IsChecked="{Binding EnableFocusDiagnostics, Mode=TwoWay}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
