<UserControl x:Class="Cwseo.NINA.ManualFocuser.Dockables.FocusLevelsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Cwseo.NINA.ManualFocuser.Dockables"
 Foreground="{DynamicResource PrimaryBrush}" PreviewKeyDown="OnPopupKeyDown">
 <Grid>
  <ToggleButton x:Name="LevelsButton" Style="{DynamicResource TB}" Width="64" Height="35" Margin="2.5" ToolTip="Display stretch and histogram" AutomationProperties.Name="Image levels">
   <TextBlock Text="Levels" FontSize="12" Foreground="{DynamicResource ButtonForegroundBrush}"/>
  </ToggleButton>
  <Popup x:Name="LevelsPopup" PlacementTarget="{Binding ElementName=LevelsButton}" Placement="Bottom" HorizontalOffset="-302" StaysOpen="True" IsOpen="{Binding IsChecked, ElementName=LevelsButton, Mode=TwoWay}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" AllowsTransparency="True" PreviewKeyDown="OnPopupKeyDown" Opened="OnPopupOpened" Closed="OnPopupClosed">
   <Border Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" CornerRadius="3">
    <StackPanel Width="340">
     <Grid Margin="0,0,0,8">
      <TextBlock Text="Display stretch" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <ToggleButton x:Name="HistogramLogButton" IsChecked="True" Style="{DynamicResource TB}" Width="40" Height="23" HorizontalAlignment="Right" ToolTip="Logarithmic histogram height reveals low-count star pixels" AutomationProperties.Name="Log histogram">
       <TextBlock Text="Log" FontSize="11" Foreground="{DynamicResource ButtonForegroundBrush}"/>
      </ToggleButton>
     </Grid>
     <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4">
      <local:FocusHistogramView x:Name="HistogramSurface" Height="112" IsHitTestVisible="False" InputBrush="{DynamicResource PrimaryBrush}" DisplayBrush="{DynamicResource SecondaryBrush}" IsLogarithmic="{Binding IsChecked, ElementName=HistogramLogButton}"/>
     </Border>
     <local:FocusLevelsTrack x:Name="LevelsTrack" Margin="-3,3,-3,0" IsEnabled="{Binding PreviewAutoStretch}"
       BlackPoint="{Binding PreviewInputBlack, Mode=TwoWay}" Midtone="{Binding PreviewInputMidtone, Mode=TwoWay}" WhitePoint="{Binding PreviewInputWhite, Mode=TwoWay}"
       ToolTip="Levels after automatic stretch. Drag a handle, or use arrow keys; Shift makes fine adjustments."/>
     <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TextBlock><Run Text="Black "/><Run Text="{Binding PreviewInputBlack, StringFormat=F3}"/></TextBlock>
      <TextBlock Grid.Column="1" HorizontalAlignment="Center"><Run Text="Mid "/><Run Text="{Binding PreviewInputMidtone, StringFormat=F3}"/></TextBlock>
      <TextBlock Grid.Column="2" HorizontalAlignment="Right"><Run Text="White "/><Run Text="{Binding PreviewInputWhite, StringFormat=F3}"/></TextBlock>
     </Grid>
     <Grid>
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="Auto" Foreground="{DynamicResource PrimaryBrush}" Opacity="0.6" FontSize="11" Margin="0,0,12,0" ToolTip="Input to the level handles: automatic stretch result"/>
       <TextBlock Text="Display" Foreground="{DynamicResource SecondaryBrush}" FontSize="11"/>
      </StackPanel>
      <TextBlock Text="0 → 1" HorizontalAlignment="Right" Opacity="0.6" FontSize="11"/>
     </Grid>
     <TextBlock x:Name="ClippingText" Text="No image" FontSize="11" Opacity="0.7" Margin="0,9,0,7" ToolTip="Percentage of source pixels at or beyond the shadow and highlight endpoints"/>
     <Button Command="{Binding ResetPreviewStretchCommand}" HorizontalAlignment="Right" Width="112" Height="28" AutomationProperties.Name="Reset levels to Auto" ToolTip="Enable stretch and restore NINA automatic settings">
      <TextBlock Text="Auto" FontSize="12" Foreground="{DynamicResource ButtonForegroundBrush}"/>
     </Button>
    </StackPanel>
   </Border>
  </Popup>
 </Grid>
</UserControl>
