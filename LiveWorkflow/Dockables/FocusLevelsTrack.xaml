<UserControl x:Class="Cwseo.NINA.ManualFocuser.Dockables.FocusLevelsTrack"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Height="30" Focusable="False" IsEnabledChanged="OnEnabledChanged">
 <UserControl.Resources>
  <Style x:Key="LevelThumb" TargetType="Thumb">
   <Setter Property="Width" Value="16"/><Setter Property="Height" Value="21"/>
   <Setter Property="Focusable" Value="True"/><Setter Property="Cursor" Value="SizeWE"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Thumb">
     <Grid Background="Transparent">
      <Path x:Name="Handle" Data="M 8,1 L 14,13 L 2,13 Z" Fill="{TemplateBinding Background}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Handle" Property="Stroke" Value="{DynamicResource SecondaryBrush}"/><Setter TargetName="Handle" Property="StrokeThickness" Value="2"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Stroke" Value="{DynamicResource SecondaryBrush}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="Surface" SizeChanged="OnTrackSizeChanged" Background="Transparent" MouseLeftButtonDown="OnTrackClick">
  <Border Margin="8,0,8,0" Height="7" VerticalAlignment="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Offset="0" Color="Black"/><GradientStop Offset="1" Color="White"/></LinearGradientBrush></Border.Background>
  </Border>
  <Canvas x:Name="Handles" Margin="0,7,0,0">
   <Thumb x:Name="BlackHandle" Style="{StaticResource LevelThumb}" Tag="Black" Background="#111111" AutomationProperties.Name="Black point" DragStarted="OnDragStarted" DragDelta="OnDragDelta" PreviewKeyDown="OnHandleKeyDown"/>
   <Thumb x:Name="MidtoneHandle" Style="{StaticResource LevelThumb}" Tag="Midtone" Background="#888888" AutomationProperties.Name="Midtone point" DragStarted="OnDragStarted" DragDelta="OnDragDelta" PreviewKeyDown="OnHandleKeyDown"/>
   <Thumb x:Name="WhiteHandle" Style="{StaticResource LevelThumb}" Tag="White" Background="#F5F5F5" AutomationProperties.Name="White point" DragStarted="OnDragStarted" DragDelta="OnDragDelta" PreviewKeyDown="OnHandleKeyDown"/>
  </Canvas>
 </Grid>
</UserControl>
